# TypeSafe AI key for Jev (https://typesafe.ai). Used server-side only.
TYPESAFE_API_KEY=
# Pin the Jev version so results don't drift silently when jev-latest moves.
JEV_MODEL=jev-1.13.0

# --- Phone alerts (optional; the open app triggers a check after each hourly candle close) ---
# Telegram (free): create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMS via Twilio (paid per message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE=
# Other push options
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
# Optional: require ?key=... on /api/alerts (enter the same key in the app)
ALERTS_KEY=
