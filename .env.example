# TypeSafe AI key for Jev (https://typesafe.ai). Used server-side only.
TYPESAFE_API_KEY=
# Pin the Jev version so results don't drift silently when jev-latest moves.
JEV_MODEL=jev-1.13.0

# --- Phone alerts (Vercel Cron calls /api/alerts at :01 every hour; needs the Pro plan) ---
# Any long random string; Vercel Cron sends it as a bearer token and the app's Send test asks for it
CRON_SECRET=
# Telegram (free): create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMS via Twilio (paid per message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE=
# Other push options
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
# Per-coin levels (the Alerts card writes these lines): priority = loud + SMS, off = not sent
ALERT_PRIORITY=
ALERT_OFF=
# 1 = only send gold alerts (1h Grade A longs with a near take-profit; see README)
ALERT_GOLD_ONLY=
# Optional second key for manual calls (?key=...); CRON_SECRET also works
ALERTS_KEY=
